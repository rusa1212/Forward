# React(Vite) 개발 서버 주소. front/vite.config.ts의 기본 PORT가 8443이므로 3000이 아니라 8443으로 맞춤
# (front를 다른 포트로 띄운다면 그 주소로 바꿀 것)
FRONTEND_ORIGIN=http://localhost:8443

ENV=local

# 공공데이터포털 발급 API 키 (4개 서비스 공용)
DATA_GO_KR_API_KEY=

# MySQL/MariaDB 접속정보
# 형식: mysql+pymysql://사용자:비밀번호@호스트:포트/DB이름?charset=utf8mb4
# 로컬 예시: mysql+pymysql://forward:forward@localhost:3306/forward?charset=utf8mb4
# 준비 절차(빈 DB 생성 → alembic upgrade head)는 back/README.md 참고.
# alembic도 이 URL로 접속하므로, 로컬에서는 이 계정에 forward.* ALL 권한을 주세요
# (공용/운영 DB는 마이그레이션 계정과 앱 계정을 분리 — docs/be/alembic-마이그레이션.md 참고).
DATABASE_URL=

# 매일 자동 수집 실행 시각 (서버 로컬 시간, 기본 06:00)
COLLECT_CRON_HOUR=6
COLLECT_CRON_MINUTE=0

# 로그인 토큰(JWT) 서명용 비밀값. 각자 원하는 랜덤 문자열로 바꿔서 쓰세요.
JWT_SECRET=change-me-in-env
JWT_EXPIRE_HOURS=24

# 알림 이메일 발송용 SMTP (선택 — 비워두면 알림 저장까지만 하고 이메일은 안 보냄, 정상 동작).
# 어떤 이메일 서비스를 쓸지 팀 결정 후 아래 값들을 채우면 코드 수정 없이 바로 발송 시작됩니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
