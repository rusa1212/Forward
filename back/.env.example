# React(Vite) 개발 서버 주소. front/vite.config.ts의 기본 PORT가 8443이므로 3000이 아니라 8443으로 맞춤
# (front를 다른 포트로 띄운다면 그 주소로 바꿀 것)
FRONTEND_ORIGIN=http://localhost:8443

ENV=local

# 공공데이터포털 발급 API 키 (4개 서비스 공용)
DATA_GO_KR_API_KEY=

# Supabase 접속정보 (Supabase 프로젝트 > Database > Connection string)
# postgresql:// 로 시작하는 원본 문자열에서 앞부분을 postgresql+psycopg2:// 로 바꿔서 넣으세요.
DATABASE_URL=

# 매일 자동 수집 실행 시각 (서버 로컬 시간, 기본 06:00)
COLLECT_CRON_HOUR=6
COLLECT_CRON_MINUTE=0

# 로그인 토큰(JWT) 서명용 비밀값. 각자 원하는 랜덤 문자열로 바꿔서 쓰세요.
JWT_SECRET=change-me-in-env
JWT_EXPIRE_HOURS=24
